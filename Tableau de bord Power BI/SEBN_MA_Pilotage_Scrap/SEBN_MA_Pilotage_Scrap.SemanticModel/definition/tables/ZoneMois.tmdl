table ZoneMois
	lineageTag: 2ed64db2-63ae-9d4d-964b-7f3f7406db04

	measure 'Valeur scrap zone (€)' = SUM(ZoneMois[ValeurEUR])
		formatString: #,0 €
		lineageTag: 5ee87f1d-5cf9-24eb-a783-dff8eed1723c

	measure 'Part de la zone (%)' = DIVIDE([Valeur scrap zone (€)], CALCULATE([Valeur scrap zone (€)], ALL(ZoneMois[Zone])))
		formatString: 0.0 %
		lineageTag: c1edbac5-386f-8730-4a91-e9fb58f26f74

	measure 'Nombre de zones actives' = CALCULATE(DISTINCTCOUNT(ZoneMois[Zone]), ZoneMois[ValeurEUR] > 0)
