		lineageTag: 7967e35e-8611-25e4-b43f-2710fccef986

	measure 'Part de la zone en kg (%)' = DIVIDE([Scrap janvier (kg)], CALCULATE([Scrap janvier (kg)], ALL(ZonesKg[Zone])))
