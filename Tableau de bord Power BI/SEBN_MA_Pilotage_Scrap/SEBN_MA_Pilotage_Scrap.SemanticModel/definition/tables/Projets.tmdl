table Projets
	lineageTag: 8df4b679-3e01-fdeb-ef79-4c2fb9ac2fff

	measure 'Coût matière (€)' = SUM(Projets[CoutMatiere])
		formatString: #,0 €
		lineageTag: 107b1e48-f2ec-3a38-e38c-7e8f907bf42b

	measure 'Coût complet (€)' = SUM(Projets[CoutComplet])
		formatString: #,0 €
		lineageTag: 223c99f2-545a-8c9d-5750-8832198fe2e6

	measure 'MOD (€)' = SUM(Projets[MOD])
		formatString: #,0 €
		lineageTag: efd13305-0782-9f82-be3a-cc15ced71bc2

	measure 'Composants non filaires (€)' = SUM(Projets[Composants])
		formatString: #,0 €
		lineageTag: 79d89cbf-7e7b-2d77-b918-7e1d2c60cc48

	measure 'Charges indirectes (€)' = SUM(Projets[ChargesInd])
		formatString: #,0 €
		lineageTag: 71de7765-fa58-77f6-8929-d5fd76b60901

	measure 'Majoration coût complet (%)' = DIVIDE([Coût complet (€)] - [Coût matière (€)], [Coût matière (€)])
		formatString: 0.0 %
		lineageTag: b221cb5d-253e-c4e1-7be3-2fa772390de0

	measure 'Budget cible (€)' = SUM(Projets[BudgetCible])
		formatString: #,0 €
		lineageTag: eab6bad3-725c-0657-abde-54ecf866e4e7

	measure 'Écart vs budget cible (%)' = DIVIDE([Coût matière (€)] - [Budget cible (€)], [Budget cible (€)])
		formatString: 0.0 %
		lineageTag: 1fab246a-ad48-1718-a748-8080d32b2f39

	measure 'Écart vs budget cible (€)' = [Coût matière (€)] - [Budget cible (€)]
		formatString: #,0 €
		lineageTag: 43e97f47-4289-668e-72e9-8bacb25c4721

	measure 'Consommation matière (€)' = SUM(Projets[ConsoEUR])
		formatString: #,0 €
		lineageTag: ebee299f-9c20-9e5d-ddd6-681800e48616

	measure 'Taux réel observé (%)' = DIVIDE([Coût matière (€)], [Consommation matière (€)])
		formatString: 0.0 %
		lineageTag: c6845316-8607-c74e-4a41-c08a19396158

	measure 'Coût complet cible (€)' = SUMX(Projets, Projets[BudgetCible] * (1 + RELATED(Familles[MajorationTotale])))
		formatString: #,0 €
		lineageTag: 9fb8444f-20ac-c801-4657-6aad1173ca9f

	measure 'Économie potentielle (€)' = [Coût complet (€)] - [Coût complet cible (€)]
		formatString: #,0 €
		lineageTag: fc9dcf37-f196-b43d-9960-6ad8ac910b16

	measure 'Économie potentielle (%)' = DIVIDE([Économie potentielle (€)], [Coût complet (€)])
		formatString: 0.0 %
		lineageTag: 69562214-49f6-6164-c103-c7b9e0c9700a

	measure 'Part du coût complet (%)' = DIVIDE([Coût complet (€)], CALCULATE([Coût complet (€)], ALL(Projets)))
		formatString: 0.0 %
		lineageTag: b9929b04-1106-1a3f-e10c-7d16d1883558

	measure 'Taux cible pondéré (%)' = DIVIDE([Budget cible (€)], [Consommation matière (€)])
		formatString: 0.0 %
		lineageTag: 39bc34ba-34ec-85c0-063d-a018e121f4b5

	measure 'Économie annualisée (€)' = [Économie potentielle (€)] * 12 / 5
		formatString: #,0 €
		lineageTag: a31fe745-9d38-ce6f-c6e6-ef3087547da2

