table Causes
	lineageTag: 328ff1e6-10c5-3a4b-3768-7992ccefc269

	measure 'Valeur cause (€)' = SUM(Causes[ValeurEUR])
		formatString: #,0 €
		lineageTag: 917916cd-0946-ca1a-7a43-283f978c2a9f

	measure 'Quantité cause' = SUM(Causes[Quantite])
		formatString: #,0
		lineageTag: 1636743d-3c8c-5fce-54e1-10e70f005d44

	measure 'Part de la cause (%)' = DIVIDE([Valeur cause (€)], CALCULATE([Valeur cause (€)], ALL(Causes[Cause])))
		formatString: 0.0 %
		lineageTag: 165fb653-da09-d33d-1e74-835d381b7eb1

	measure 'Cumul Pareto (%)' =
			VAR _cur = [Valeur cause (€)]
			VAR _tot = CALCULATE([Valeur cause (€)], ALL(Causes[Cause]))
			VAR _cum =
			    SUMX(
			        FILTER(ALL(Causes[Cause]), CALCULATE([Valeur cause (€)]) >= _cur),
			        CALCULATE([Valeur cause (€)])
			    )
			RETURN DIVIDE(_cum, _tot)
		formatString: 0.0 %
		lineageTag: b896cdea-f954-67ee-1684-58cda9629eee

